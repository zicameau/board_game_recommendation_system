# Copy to `/opt/bgg-rec-sys/.env.deploy` on the VPS (same directory as `docker-compose.prod.yml`).
# CI overwrites this file each deploy but preserves an existing CADDY_EMAIL line (or set GitHub secret CADDY_EMAIL).
#
# BGG_REC_IMAGE=ghcr.io/YOUR_GITHUB_USER/bgg-rec-sys:main
# CADDY_EMAIL=you@yourdomain.com

BGG_REC_IMAGE=ghcr.io/CHANGE_ME/bgg-rec-sys:main
