# Copy to .env.local and fill in values (see docs/local-development.md and README).

ENVIRONMENT=local
AUTH_MODE=supabase
# AUTH_MODE=dev_shim
# For dev_shim + docker Postgres use DATABASE_URL below; authenticate via X-Dev-User header or ?dev_user= in browser

# App DB — pick ONE setup:
#
# (A) Local Docker (compose maps host port 5433 -> Postgres 5432; avoids local Postgres on 5432)
# DATABASE_URL=postgresql://bgg:bgg@127.0.0.1:5433/bgg_dev
#
# (B) Supabase IPv4 — prefer pasting the URI from Dashboard → Connect:
#   - Transaction pooler: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:6543/postgres
#   - Session pooler:     postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Percent-encode special characters in PASSWORD (# @ : / ? $ % * …). Python: quote(password, safe='').
# DATABASE_URL=...
# ALEMBIC_DATABASE_URL=...

SUPABASE_URL=https://PROJECT.supabase.co
# Publishable key — use either name (same value loads as settings.SUPABASE_ANON_KEY):
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:8000"]

SECURE_COOKIES=false
SESSION_SECRET=change-me-to-random-string-for-session-signing

# Model bundle (local path containing MODEL_VERSION subdirectory)
MODEL_BUNDLE_PATH=bundles
MODEL_VERSION=popularity-v1-fixture
# In production Docker builds, MODEL_VERSION selects which bundles/<name>/ directory is baked in;
# CI uses repository variable MODEL_VERSION (see docs/production.md).

LOG_LEVEL=INFO
